# PostgreSQL
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo_secret_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL_ATLAS=postgresql://demo:demo_secret_change_me@postgres:5432/atlas_logistics
DATABASE_URL_MAGHREB=postgresql://demo:demo_secret_change_me@postgres:5432/maghreb_freight
DATABASE_URL_SAHARA=postgresql://demo:demo_secret_change_me@postgres:5432/sahara_transport
DATABASE_URL_AUDIT=postgresql://demo:demo_secret_change_me@postgres:5432/sovereignty_audit

# Service URLs
COORDINATOR_URL=http://coordinator:8000
GUARD_ATLAS_URL=http://guard-atlas:8010
GUARD_MAGHREB_URL=http://guard-maghreb:8011
GUARD_SAHARA_URL=http://guard-sahara:8012
AGENT_ATLAS_URL=http://agent-atlas:8020
AGENT_MAGHREB_URL=http://agent-maghreb:8021
AGENT_SAHARA_URL=http://agent-sahara:8022

# Frontend
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8000

# ─── Auth ──────────────────────────────────────────────────────────────────
# Shared secret for internal service-to-service calls (X-Service-Key header)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTER_SERVICE_KEY=change_me_generate_a_real_secret

# JWT secret for partner-to-partner token validation (HS256 for now)
# In production: use RS256 with per-org keypairs
PARTNER_JWT_SECRET=change_me_generate_a_real_jwt_secret

# ─── OpenRouter AI (Primary Reasoning Engine) ──────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended models:
# - google/gemini-2.0-flash-001 (fast & smart)
# - meta-llama/llama-3.3-70b-instruct
# - deepseek/deepseek-chat
# - anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── Optional: Direct Gemini AI Fallback ────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
