{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "outDir": "dist",
    "esModuleInterop": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"]
}
